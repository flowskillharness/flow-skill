---
interface Props {
	command: string;
	copyLabel: string;
	copiedLabel: string;
	selectLabel: string;
	secondaryHref: string;
	secondaryLabel: string;
}

const { command, copyLabel, copiedLabel, selectLabel, secondaryHref, secondaryLabel } =
	Astro.props;

// Generate derived commands for alternative package managers preserving version tag
const npxCmd = command;
const pnpmCmd = command.replace(/^npx\s+/, 'pnpm dlx ');
const npmCmd = command.replace(/^npx\s+/, 'npm exec ');
---

<div class="install-lockup" data-lockup>
	<div class="install-header">
		<div class="install-header-left">
			<div class="terminal-chrome" aria-hidden="true">
				<span class="terminal-dot"></span>
				<span class="terminal-dot"></span>
				<span class="terminal-dot"></span>
			</div>
			<div class="install-tabs" role="tablist" aria-label="Install method">
			<button
				type="button"
				role="tab"
				class="tab-btn active mono"
				data-tab="npx"
				data-cmd={npxCmd}
				aria-selected="true"
				aria-controls="install-code-box"
			>
				npx
			</button>
			<button
				type="button"
				role="tab"
				class="tab-btn mono"
				data-tab="pnpm"
				data-cmd={pnpmCmd}
				aria-selected="false"
				aria-controls="install-code-box"
			>
				pnpm
			</button>
			<button
				type="button"
				role="tab"
				class="tab-btn mono"
				data-tab="npm"
				data-cmd={npmCmd}
				aria-selected="false"
				aria-controls="install-code-box"
			>
				npm
			</button>
			</div>
		</div>
		<span class="runtime-tag mono">NODE ≥22</span>
	</div>

	<div class="install-box">
		<span class="prompt-glyph mono" aria-hidden="true">$</span>
		<code id="install-code-box" class="cmd mono" translate="no" data-command>{command}</code>
		<button
			class="copy-btn mono"
			type="button"
			data-copy
			aria-label={copyLabel}
		>
			<span class="copy-text">{copyLabel}</span>
			<span class="copied-text" aria-hidden="true">✓ {copiedLabel}</span>
		</button>
	</div>

	<div class="install-subline">
		<span
			class="copy-status-sr"
			role="status"
			aria-live="polite"
			data-status
			data-done={copiedLabel}
			data-fallback={selectLabel}
		></span>
		{secondaryHref && (
			<a class="install-secondary-link mono" href={secondaryHref}>
				{secondaryLabel} <span aria-hidden="true">→</span>
			</a>
		)}
	</div>
</div>

<script>
	function selectNode(node: HTMLElement) {
		const selection = window.getSelection();
		if (!selection) return;
		const range = document.createRange();
		range.selectNodeContents(node);
		selection.removeAllRanges();
		selection.addRange(range);
	}

	document.querySelectorAll<HTMLElement>('[data-lockup]').forEach((lockup) => {
		const code = lockup.querySelector<HTMLElement>('[data-command]');
		const copyBtn = lockup.querySelector<HTMLButtonElement>('[data-copy]');
		const status = lockup.querySelector<HTMLElement>('[data-status]');
		const tabButtons = lockup.querySelectorAll<HTMLButtonElement>('.tab-btn');

		if (!code || !copyBtn) return;

		let resetTimer = 0;

		// Tab switching logic
		tabButtons.forEach((tab) => {
			tab.addEventListener('click', () => {
				tabButtons.forEach((t) => {
					t.classList.remove('active');
					t.setAttribute('aria-selected', 'false');
				});
				tab.classList.add('active');
				tab.setAttribute('aria-selected', 'true');

				const nextCmd = tab.getAttribute('data-cmd');
				if (nextCmd) {
					code.textContent = nextCmd;
				}

				// Reset copied state on tab change
				copyBtn.removeAttribute('data-copied');
				if (status) status.textContent = '';
			});
		});

		// Copy command logic with animated feedback
		copyBtn.addEventListener('click', async () => {
			const textToCopy = code.textContent?.trim() ?? '';
			try {
				await navigator.clipboard.writeText(textToCopy);
				if (status) status.textContent = status.getAttribute('data-done') ?? 'Copied';
			} catch {
				selectNode(code);
				if (status) status.textContent = status.getAttribute('data-fallback') ?? 'Selected';
			}

			copyBtn.setAttribute('data-copied', 'true');
			window.clearTimeout(resetTimer);
			resetTimer = window.setTimeout(() => {
				copyBtn.removeAttribute('data-copied');
				if (status) status.textContent = '';
			}, 2400);
		});
	});
</script>
