---
import { getVersions } from '../lib/versions';

interface Props {
	lang: 'en' | 'vi';
}

const { lang } = Astro.props;

const { skillVersion: skill, installerVersion: installer } = await getVersions();

const copy = {
	en: {
		imprint: 'flow — a gated build harness for coding agents.',
		tagline: 'Proof over vibes.',
		edition: `skill ${skill} · npm installer ${installer}`,
		links: 'Project links',
		docs: 'Docs',
		locale: 'Language',
	},
	vi: {
		imprint: 'flow — cổng cho agent viết code.',
		tagline: 'Bằng chứng hơn cảm hứng.',
		edition: `skill ${skill} · npm installer ${installer}`,
		links: 'Link dự án',
		docs: 'Tài liệu',
		locale: 'Ngôn ngữ',
	},
}[lang];

const docsHome = lang === 'vi' ? '/vi/docs/' : '/docs/';
---

<footer class="colophon">
	<div class="colophon-inner">
		<div class="imprint">
			<a href={lang === 'vi' ? '/vi/' : '/'} class="colophon-brand" aria-label="flow — gated build harness for coding agents">
				<img class="colophon-logo-dark" src="/brand/brand-lockup-dark.svg" alt="flow" width="128" height="34" />
				<img class="colophon-logo-light" src="/brand/brand-lockup-light.svg" alt="flow" width="128" height="34" />
			</a>
			<p class="imprint-line">{copy.imprint}</p>
			<p class="tagline mono">{copy.tagline}</p>
			{skill && installer && <p class="edition mono">{copy.edition}</p>}
		</div>
		<div class="colophon-links-group">
			<nav class="colophon-nav" aria-label={copy.links}>
				<a href="https://github.com/manhquydev/flow-skill" target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href="https://www.npmjs.com/package/@manhquy/flow-skill" translate="no" target="_blank" rel="noopener noreferrer"
					>@manhquy/flow-skill</a
				>
				<a href={docsHome}>{copy.docs}</a>
			</nav>
			<nav class="colophon-locale" aria-label={copy.locale}>
				<a href="/" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>English</a>
				<span class="nav-sep" aria-hidden="true">/</span>
				<a href="/vi/" lang="vi" aria-current={lang === 'vi' ? 'page' : undefined}>Tiếng Việt</a>
			</nav>
		</div>
	</div>
</footer>

<style>
	.colophon {
		width: 100%;
		border-top: 1px solid rgba(226, 232, 240, 0.12);
		background: #0F172A;
		padding: 2.75rem 0 3.25rem;
		margin-top: auto;
	}
	:global([data-theme='light']) .colophon {
		background: #F8FAFC;
		border-top: 1px solid #E2E8F0;
	}
	.colophon-inner {
		max-width: var(--max-w, 1200px);
		margin-inline: auto;
		padding-inline: var(--gutter, 1.5rem);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
	}
	.imprint {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		max-width: 460px;
	}
	.colophon-brand {
		display: inline-flex;
		align-items: center;
		margin-bottom: 0.25rem;
		text-decoration: none;
	}
	.colophon-brand img {
		height: 30px;
		width: auto;
	}
	.colophon-logo-dark {
		display: block;
	}
	.colophon-logo-light {
		display: none;
	}
	:global([data-theme='light']) .colophon-logo-dark {
		display: none;
	}
	:global([data-theme='light']) .colophon-logo-light {
		display: block;
	}
	.imprint-line {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 500;
		color: #E2E8F0;
		line-height: 1.5;
	}
	:global([data-theme='light']) .imprint-line {
		color: #0F172A;
	}
	.tagline {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: #5BC8DE;
		letter-spacing: 0.06em;
		font-family: 'JetBrains Mono', 'Azeret Mono', 'SF Mono', monospace;
	}
	:global([data-theme='light']) .tagline {
		color: #0A4E5E;
	}
	.edition {
		margin: 0.15rem 0 0;
		font-size: 0.78rem;
		color: #94A3B8;
		font-family: 'JetBrains Mono', 'Azeret Mono', 'SF Mono', monospace;
	}
	:global([data-theme='light']) .edition {
		color: #475569;
	}
	.colophon-links-group {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 1.25rem;
	}
	.colophon-nav,
	.colophon-locale {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.88rem;
		font-family: 'JetBrains Mono', 'Azeret Mono', 'SF Mono', monospace;
	}
	.colophon-nav a,
	.colophon-locale a {
		color: #94A3B8;
		text-decoration: none;
		transition: color 140ms ease;
	}
	:global([data-theme='light']) .colophon-nav a,
	:global([data-theme='light']) .colophon-locale a {
		color: #475569;
	}
	.colophon-nav a:hover,
	.colophon-locale a:hover {
		color: #1AA3C4;
	}
	:global([data-theme='light']) .colophon-nav a:hover,
	:global([data-theme='light']) .colophon-locale a:hover {
		color: #0A4E5E;
	}
	.colophon-locale a[aria-current='page'] {
		color: #5BC8DE;
		font-weight: 700;
	}
	:global([data-theme='light']) .colophon-locale a[aria-current='page'] {
		color: #0A4E5E;
	}
	.nav-sep {
		color: #475569;
	}
	@media (max-width: 768px) {
		.colophon-inner {
			flex-direction: column;
			gap: 1.5rem;
		}
		.colophon-links-group {
			align-items: flex-start;
		}
	}
</style>
