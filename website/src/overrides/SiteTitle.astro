---
const locale = Astro.locals.starlightRoute?.locale;
const href = locale === 'vi' ? '/vi/' : '/';
const siteTitle = Astro.props.siteTitle ?? Astro.locals.starlightRoute?.siteTitle ?? 'flow';
---

<a href={href} class="brand-lockup" aria-label="flow — gated build harness for coding agents">
	<picture>
		<source media="(prefers-color-scheme: dark)" srcset="/brand/brand-lockup-dark.svg" />
		<img src="/brand/brand-lockup-light.svg" alt="flow — gated build harness for coding agents" width="156" height="42" />
	</picture>
	<span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.brand-lockup {
			display: flex;
			align-items: center;
			text-decoration: none;
			min-width: 0;
		}
		.brand-lockup img {
			height: 36px;
			width: auto;
			display: block;
			max-width: 100%;
			object-fit: contain;
		}
		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
	}
</style>
