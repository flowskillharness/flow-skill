---
const locale = Astro.locals.starlightRoute?.locale;
const href = locale === 'vi' ? '/vi/' : '/';
const siteTitle = Astro.props.siteTitle ?? Astro.locals.starlightRoute?.siteTitle ?? 'flow';
---

<a href={href} class="brand-lockup" aria-label="flow — gated build harness for coding agents">
	<img class="site-logo-dark" src="/brand/brand-lockup-dark.svg" alt="flow — gated build harness for coding agents" width="156" height="42" />
	<img class="site-logo-light" src="/brand/brand-lockup-light.svg" alt="flow — gated build harness for coding agents" width="156" height="42" />
	<span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
	@layer starlight.core {
		.brand-lockup {
			display: flex;
			align-items: center;
			text-decoration: none;
			min-width: 0;
		}
		.brand-lockup img {
			height: 36px;
			width: auto;
			max-width: 100%;
			object-fit: contain;
		}
		.site-logo-dark {
			display: block;
		}
		.site-logo-light {
			display: none;
		}
		:global([data-theme='light']) .site-logo-dark {
			display: none;
		}
		:global([data-theme='light']) .site-logo-light {
			display: block;
		}
		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}
	}
</style>
