---
import Colophon from '../components/Colophon.astro';
import '../../node_modules/@fontsource/archivo/400.css';
import '../../node_modules/@fontsource/archivo/600.css';
import '../../node_modules/@fontsource/archivo/700.css';
import '../../node_modules/@fontsource/azeret-mono/500.css';
import '../styles/landing.css';

interface Props {
	lang: 'en' | 'vi';
	dir?: 'ltr';
}

const { lang } = Astro.props;
const docsHome = lang === 'vi' ? '/vi/docs/' : '/docs/';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<link rel="icon" type="image/svg+xml" href="/brand/icons/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/icons/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/brand/icons/favicon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/brand/icons/apple-touch-icon-180.png" />
		<meta property="og:image" content="https://flowskill.io.vn/brand/og-image-1200x630.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://flowskill.io.vn/brand/og-image-1200x630.png" />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#content">{lang === 'vi' ? 'Tới nội dung' : 'Skip to content'}</a>
		<svg class="marks" aria-hidden="true">
			<defs>
				<symbol id="reg" viewBox="0 0 16 16">
					<circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1" />
					<line x1="8" y1="0" x2="8" y2="16" stroke="currentColor" stroke-width="1" />
					<line x1="0" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1" />
				</symbol>
				<symbol id="tick" viewBox="0 0 40 40">
					<path d="M6 22 L16 32 L34 8" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
				</symbol>
			</defs>
		</svg>
		<header class="docket">
			<div class="docket-inner">
				<a href={lang === 'vi' ? '/vi/' : '/'} class="brand-lockup" aria-label="flow — gated build harness for coding agents">
					<picture>
						<source media="(prefers-color-scheme: light)" srcset="/brand/brand-lockup-light.svg" />
						<img class="brand-logo-img" src="/brand/brand-lockup-dark.svg" alt="flow — gated build harness for coding agents" width="156" height="42" />
					</picture>
				</a>
				<nav class="docket-nav" aria-label={lang === 'vi' ? 'Ngôn ngữ và tài liệu' : 'Language and docs'}>
					<a href="/" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
					<span class="nav-sep" aria-hidden="true">/</span>
					<a href="/vi/" aria-current={lang === 'vi' ? 'page' : undefined}>VI</a>
					<a class="docs-link" href={docsHome}>{lang === 'vi' ? 'Tài liệu' : 'Docs'}</a>
				</nav>
			</div>
		</header>
		<div id="content">
			<slot />
		</div>
		<Colophon lang={lang} />
	</body>
</html>
