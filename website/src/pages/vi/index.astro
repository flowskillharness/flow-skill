---
import Landing from '../../layouts/Landing.astro';
import InstallLockup from '../../components/InstallLockup.astro';
import { getVersions } from '../../lib/versions';

const { command } = await getVersions();
const tutorial = '/vi/docs/tutorials/install-and-first-run/';
const stages = [
	{ num: '01', name: 'Idea', file: 'flow/00-idea.md', tagline: 'Loại ý tưởng yếu trước khi đụng vào code.' },
	{ num: '02', name: 'Research', file: 'flow/01-research.md', tagline: 'Dẫn nguồn thật hoặc dừng tại đây.' },
	{ num: '03', name: 'Scope', file: 'flow/02-scope.md', tagline: 'Vạch rõ ranh giới. Cắt bỏ phần thừa.' },
	{ num: '04', name: 'PRD', file: 'flow/03-prd.md', tagline: 'Chốt tiêu chí test trước khi viết code.' },
	{ num: '05', name: 'ADR', file: 'flow/04-adr.md', tagline: 'Ghi nhận đánh đổi trước khi commit.' },
	{ num: '06', name: 'Contract', file: 'flow/05-contract.md', tagline: 'Cả hai cùng duyệt mới được đi tiếp.' },
];
const agents = [
	'Claude Code',
	'Codex CLI',
	'Gemini CLI',
	'Cursor',
	'Aider',
	'Cline',
	'Continue',
	'Zed',
];
const afterInstall = [
	'File skill nằm gọn trong thư mục của agent.',
	'Gõ /flow trong chat (Codex: $flow).',
	'Lệnh doctor in ra READY.',
	'/flow next trên file idea trống sẽ từ chối và chỉ rõ số dòng.',
];
const willNotPass = [
	'File còn để trống.',
	'Còn sót token [FILL] chưa điền.',
	'Báo “tests pass” thay vì đưa bằng chứng done.',
];
---

<Landing lang="vi">
	<title slot="head">flow — tiến độ ảo không qua được gate</title>
	<meta
		slot="head"
		name="description"
		content="Harness kiểm soát bằng gate cho coding agent bạn đang dùng. flow giữ gate và biên nhận, không can thiệp runtime. Dừng ở gate là kết quả hợp lệ. npx @manhquy/flow-skill@latest"
	/>
	<main class="landing-main">
		<!-- HERO SECTION -->
		<section class="hero-section" aria-label="Cài đặt và kết quả kiểm chứng">
			<div class="hero-atmosphere" aria-hidden="true"></div>
			<canvas id="hero-flow-canvas" class="hero-flow-canvas" aria-hidden="true"></canvas>
			<div class="hero">
				<div class="hero-copy">
					<div class="kicker-wrap hero-kicker-anim">
						<span class="kicker mono"><span class="kicker-dot" aria-hidden="true"></span>BẰNG CHỨNG HƠN CẢM HỨNG.</span>
					</div>
					<p class="display mono hero-display-anim" translate="no">flow</p>
					<h1 class="headline hero-title-anim"><span class="headline-gradient">Tiến độ ảo</span> không qua được gate.</h1>
					<p class="lede hero-lede-anim">
						flow là harness kiểm soát bằng gate cho coding agent bạn đang dùng. flow giữ gate và biên nhận,
						không can thiệp runtime. Dừng lại ở gate là kết quả hợp lệ, được ghi nhận.
					</p>
					<p class="verdict mono hero-verdict-anim">Gate chỉ mở khi cả hai cùng duyệt.</p>
				</div>

				<!-- TABBED INSTALL WIDGET -->
				<div class="hero-install hero-install-anim">
					<InstallLockup
						command={command}
						copyLabel="Copy"
						copiedLabel="Đã copy"
						selectLabel="Đã chọn — nhấn Ctrl+C"
						secondaryHref={tutorial}
						secondaryLabel="Cài đặt và lần chạy đầu"
					/>
				</div>
			</div>

			<!-- AGENT MARQUEE -->
			<div class="marquee-wrapper" aria-label="Tương thích với các coding agent">
				<p class="marquee-label mono">HOẠT ĐỘNG CÙNG CÁC CODING AGENT BẠN DÙNG</p>
				<div class="marquee" tabindex="0" role="region" aria-label="Danh sách coding agent tương thích">
					<div class="marquee-track">
						<div class="marquee-group">
							{agents.map((agent) => (
								<span class="agent-chip mono">{agent}</span>
							))}
						</div>
						<div class="marquee-group" aria-hidden="true">
							{agents.map((agent) => (
								<span class="agent-chip mono">{agent}</span>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- NUMBERED GATES 01-06 (FULL-WIDTH BANDS) -->
		<section class="band run gates-section" aria-labelledby="run-title">
			<div class="band-intro">
				<h2 class="band-title" id="run-title">6 gate kiểm soát trước khi build</h2>
				<p class="band-lede">
					Mỗi stage ghi một file thật vào repo. <code translate="no">/flow next</code> chỉ mở
					khóa stage kế tiếp khi cả runner lẫn skill cùng duyệt. Các file này hình thành
					khi bạn vượt qua từng gate, không phải tự sinh sau khi cài.
				</p>
			</div>

			<!-- Stage pipeline index -->
			<ol class="pipeline" aria-label="Quy trình 6 gate từ Idea đến Contract">
				{stages.map((stage) => (
					<li class="pipe">
						<a href={`#gate-${stage.num}`} class="pipe-link gate-chip">
							<span class="pipe-num mono">{stage.num}</span>
							<span class="pipe-name">{stage.name}</span>
						</a>
					</li>
				))}
			</ol>

			<div class="gates-container">
				<!-- Gate 01: Idea (Features What Will Not Pass proof panel) -->
				<article class="gate-band" id="gate-01" aria-labelledby="gate-01-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">01</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">01</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-01-title">Idea</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/00-idea.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Loại ý tưởng yếu trước khi đụng vào code.</p>

							<!-- Artifact preview visual: Idea Markdown file with [FILL] placeholder -->
							<div class="artifact-preview artifact-idea" aria-label="Bản xem trước: flow/00-idea.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/00-idea.md</span>
									<span class="artifact-status-pill status-halt mono">CHẶN</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-kw">#</span> Vấn đề cần giải quyết</div>
									<div class="art-line art-line-warn"><span class="art-ln">2</span><span class="art-slot-fill">[FILL: mô tả vấn đề người dùng]</span></div>
									<div class="art-line"><span class="art-ln">3</span><span class="art-kw">#</span> Đề xuất giải pháp</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-muted">&lt;trống&gt;</span></div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">exit: 1 · còn sót token [FILL] chưa điền</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-fail" aria-labelledby="will-not-pass-title">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-fail" aria-hidden="true">
										<span class="fail-dot"></span>
									</span>
									<span class="proof-badge-label mono">FAIL · DỪNG TẠI GATE</span>
									<h4 id="will-not-pass-title" class="proof-title">Những gì không qua được gate</h4>
								</div>
								<p class="proof-intro">
									File trống, sót token <code translate="no">[FILL]</code>, hay chỉ nói miệng “tests pass” đều bị chặn.
									<span class="kill-line">Ý tưởng yếu sẽ dừng ngay tại gate.</span>
								</p>
								<ul class="proofs">{willNotPass.map((item) => <li>{item}</li>)}</ul>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow next<br />
									<span class="receipt-err">refusing: flow/00-idea.md is empty (line 1)</span><br />
									<span class="receipt-halt">dừng ở gate là kết quả hợp lệ.</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 02: Research -->
				<article class="gate-band" id="gate-02" aria-labelledby="gate-02-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">02</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">02</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-02-title">Research</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/01-research.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Dẫn nguồn thật hoặc dừng tại đây.</p>

							<!-- Artifact preview visual: Research primary sources citations -->
							<div class="artifact-preview artifact-research" aria-label="Bản xem trước: flow/01-research.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/01-research.md</span>
									<span class="artifact-status-pill status-verified mono">3/3 NGUỒN</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-kw">##</span> Nguồn tài liệu gốc</div>
									<div class="art-line art-line-cite"><span class="art-ln">2</span><span class="art-bullet">•</span> [RFC-9110] §4.2 Phương thức idempotent</div>
									<div class="art-line art-line-cite"><span class="art-ln">3</span><span class="art-bullet">•</span> github.com/owner/repo#412 (repro)</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-kw">##</span> So sánh đối thủ &amp; các kịch bản lỗi</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">URL đã xác thực · chốt xong dữ liệu thực chứng</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">02</span>
									<span class="proof-badge-label mono">BẰNG CHỨNG · NGUỒN TÀI LIỆU GỐC</span>
									<h4 class="proof-title">Dữ liệu thực chứng trước khi lên kiến trúc</h4>
								</div>
								<p class="proof-intro">
									So sánh đối thủ, trích dẫn tài liệu thật và ghi nhận failure mode vào repo.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 01-research<br />
									<span class="receipt-ok">✓ 3 nguồn tài liệu gốc được kiểm chứng (URL thật)</span><br />
									<span class="receipt-ok">✓ phân tích đối thủ &amp; failure mode đã khóa</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 03: Scope -->
				<article class="gate-band" id="gate-03" aria-labelledby="gate-03-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">03</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">03</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-03-title">Scope</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/02-scope.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Vạch rõ ranh giới. Cắt bỏ phần thừa.</p>

							<!-- Artifact preview visual: Scope in-scope vs non-goals perimeter -->
							<div class="artifact-preview artifact-scope" aria-label="Bản xem trước: flow/02-scope.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/02-scope.md</span>
									<span class="artifact-status-pill status-frozen mono">ĐÃ KHÓA</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-tag-scope art-tag-in">TRONG-PHẠM-VI</span> S-01 Vòng lặp gate CLI</div>
									<div class="art-line"><span class="art-ln">2</span><span class="art-tag-scope art-tag-in">TRONG-PHẠM-VI</span> S-02 Kiểm tra schema biên nhận</div>
									<div class="art-line art-line-cut"><span class="art-ln">3</span><span class="art-tag-scope art-tag-out">NGOÀI-PHẠM-VI</span> Thu thập telemetry / tracking</div>
									<div class="art-line art-line-cut"><span class="art-ln">4</span><span class="art-tag-scope art-tag-out">NGOÀI-PHẠM-VI</span> Daemon đám mây riêng</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">2 phần việc bàn giao · ranh giới đã khóa</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">03</span>
									<span class="proof-badge-label mono">RANH GIỚI · NON-GOALS</span>
									<h4 class="proof-title">Khóa cứng danh sách non-goals</h4>
								</div>
								<p class="proof-intro">
									Gói gọn từng phần việc bàn giao. Chặn đứng scope creep trước khi agent bắt đầu sinh code.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 02-scope<br />
									<span class="receipt-ok">✓ 3 phần việc bàn giao đã khóa</span><br />
									<span class="receipt-ok">✓ non-goals đã khóa cứng (chặn đứng scope creep)</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 04: PRD -->
				<article class="gate-band" id="gate-04" aria-labelledby="gate-04-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">04</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">04</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-04-title">PRD</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/03-prd.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Chốt tiêu chí test trước khi viết code.</p>

							<!-- Artifact preview visual: PRD observable invariant list -->
							<div class="artifact-preview artifact-prd" aria-label="Bản xem trước: flow/03-prd.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/03-prd.md</span>
									<span class="artifact-status-pill status-verified mono">TIÊU CHÍ</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-inv-id">INV-01:</span> exit 1 khi spec file còn trống</div>
									<div class="art-line"><span class="art-ln">2</span><span class="art-inv-id">INV-02:</span> in dòng từ chối ra stderr</div>
									<div class="art-line"><span class="art-ln">3</span><span class="art-inv-id">INV-03:</span> biên nhận JSON đúng định dạng schema</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-inv-id">INV-04:</span> chế độ degrade tự ghi nhận technical debt</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">4 điều kiện bất biến kiểm chứng được · 0 từ ngữ mơ hồ</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">04</span>
									<span class="proof-badge-label mono">CAM KẾT · TIÊU CHÍ NGHIỆM THU</span>
									<h4 class="proof-title">Chỉ chấp nhận tiêu chí kiểm chứng được</h4>
								</div>
								<p class="proof-intro">
									User stories đi kèm điều kiện bất biến kiểm thử được. Agent không thể tự ý đổi định nghĩa done giữa chừng.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 03-prd<br />
									<span class="receipt-ok">✓ tiêu chí nghiệm thu kiểm chứng được đã xác nhận</span><br />
									<span class="receipt-ok">✓ trạng thái lỗi &amp; luồng xử lý degrade đã xác định</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 05: ADR -->
				<article class="gate-band" id="gate-05" aria-labelledby="gate-05-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">05</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">05</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-05-title">ADR</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/04-adr.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Ghi nhận đánh đổi trước khi commit.</p>

							<!-- Artifact preview visual: ADR architecture decision record -->
							<div class="artifact-preview artifact-adr" aria-label="Bản xem trước: flow/04-adr.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">ADR</span>
									<span class="artifact-path mono" translate="no">flow/04-adr.md</span>
									<span class="artifact-status-pill status-accepted mono">CHẤP NHẬN</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-field">Trạng thái:</span> <span class="art-val-ok">Chấp nhận</span> (2026-10-11)</div>
									<div class="art-line"><span class="art-ln">2</span><span class="art-field">Bối cảnh:</span> Lưu file trong repo vs chạy daemon SQLite</div>
									<div class="art-line"><span class="art-ln">3</span><span class="art-field">Quyết định:</span> Dùng file Markdown trong git</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-field">Hệ quả:</span> Portable; không cần background server</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">đã tính đường lùi · chốt xong đánh đổi</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">05</span>
									<span class="proof-badge-label mono">QUYẾT ĐỊNH · ĐÁNH ĐỔI</span>
									<h4 class="proof-title">Bản ghi quyết định kiến trúc</h4>
								</div>
								<p class="proof-intro">
									Ghi nhận bối cảnh, quyết định và hệ quả trước khi bắt đầu code.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 04-adr<br />
									<span class="receipt-ok">✓ bối cảnh, quyết định và hệ quả đã ghi nhận</span><br />
									<span class="receipt-ok">✓ khả năng rollback &amp; kịch bản kiểm thử lỗi đã đối chiếu</span>
								</div>
							</div>
						</div>
