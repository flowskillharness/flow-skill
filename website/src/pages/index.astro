---
import Landing from '../layouts/Landing.astro';
import InstallLockup from '../components/InstallLockup.astro';
import { getVersions } from '../lib/versions';

const { command } = await getVersions();
const tutorial = '/docs/tutorials/install-and-first-run/';
const stages = [
	{ num: '01', name: 'Idea', file: 'flow/00-idea.md', tagline: 'Kill bad ideas before code exists.' },
	{ num: '02', name: 'Research', file: 'flow/01-research.md', tagline: 'Cite real sources or stop here.' },
	{ num: '03', name: 'Scope', file: 'flow/02-scope.md', tagline: 'Draw the boundary. Drop the rest.' },
	{ num: '04', name: 'PRD', file: 'flow/03-prd.md', tagline: 'Define the test before writing code.' },
	{ num: '05', name: 'ADR', file: 'flow/04-adr.md', tagline: 'Log the trade-off before you commit.' },
	{ num: '06', name: 'Contract', file: 'flow/05-contract.md', tagline: 'Both sides agree or nothing advances.' },
];
const agents = [
	'Claude Code',
	'Codex CLI',
	'Gemini CLI',
	'Cursor',
	'Aider',
	'Cline',
	'Continue',
	'Zed',
];
const afterInstall = [
	'Skill files land in the agent home.',
	'Type /flow (Codex: $flow).',
	'doctor can print READY.',
	'/flow next on an empty idea file refuses with line numbers.',
];
const willNotPass = [
	'An empty file.',
	'A leftover [FILL] still in the file.',
	'“Tests pass” offered as done.',
];
---

<Landing lang="en">
	<title slot="head">flow — hollow work does not advance</title>
	<meta
		slot="head"
		name="description"
		content="A gated harness around the coding agent you already use. npx @manhquy/flow-skill@latest. Killing a weak idea at a gate is valid. Not an agent."
	/>
	<main class="landing-main">
		<!-- HERO SECTION -->
		<section class="hero-section" aria-label="Install and outcomes">
			<div class="hero-atmosphere" aria-hidden="true"></div>
			<canvas id="hero-flow-canvas" class="hero-flow-canvas" aria-hidden="true"></canvas>
			<div class="hero">
				<div class="hero-copy">
					<div class="kicker-wrap hero-kicker-anim">
						<span class="kicker mono"><span class="kicker-dot" aria-hidden="true"></span>PROOF OVER VIBES.</span>
					</div>
					<p class="display mono hero-display-anim" translate="no">flow</p>
					<h1 class="headline hero-title-anim"><span class="headline-gradient">Hollow work</span> does not advance.</h1>
					<p class="lede hero-lede-anim">
						A gated harness around the coding agent you already use. Flow owns the gates and
						the receipts, never the runtime. Killing a weak idea at a gate is a valid outcome.
					</p>
					<p class="verdict mono hero-verdict-anim">The gate opens only when both agree.</p>
				</div>

				<!-- TABBED INSTALL WIDGET -->
				<div class="hero-install hero-install-anim">
					<InstallLockup
						command={command}
						copyLabel="Copy"
						copiedLabel="Copied"
						selectLabel="Selected — press Ctrl+C"
						secondaryHref={tutorial}
						secondaryLabel="Install and first run"
					/>
				</div>
			</div>

			<!-- AGENT MARQUEE -->
			<div class="marquee-wrapper" aria-label="Works with your coding agents">
				<p class="marquee-label mono">WORKS WITH YOUR CODING AGENTS</p>
				<div class="marquee" tabindex="0" role="region" aria-label="Coding agent badges">
					<div class="marquee-track">
						<div class="marquee-group">
							{agents.map((agent) => (
								<span class="agent-chip mono">{agent}</span>
							))}
						</div>
						<div class="marquee-group" aria-hidden="true">
							{agents.map((agent) => (
								<span class="agent-chip mono">{agent}</span>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- NUMBERED GATES 01-06 (FULL-WIDTH BANDS) -->
		<section class="band run gates-section" aria-labelledby="run-title">
			<div class="band-intro">
				<h2 class="band-title" id="run-title">Six gates before you build</h2>
				<p class="band-lede">
					Each stage writes a real file in your repo. <code translate="no">/flow next</code> will
					not unlock the next one until the runner and the skill both agree. Those files exist
					after you walk the gates, not after install.
				</p>
			</div>

			<!-- Stage pipeline index -->
			<ol class="pipeline" aria-label="Idea through Contract">
				{stages.map((stage) => (
					<li class="pipe">
						<a href={`#gate-${stage.num}`} class="pipe-link gate-chip">
							<span class="pipe-num mono">{stage.num}</span>
							<span class="pipe-name">{stage.name}</span>
						</a>
					</li>
				))}
			</ol>

			<div class="gates-container">
				<!-- Gate 01: Idea (Features What Will Not Pass proof panel) -->
				<article class="gate-band" id="gate-01" aria-labelledby="gate-01-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">01</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">01</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-01-title">Idea</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/00-idea.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Kill bad ideas before code exists.</p>

							<!-- Artifact preview visual: Idea Markdown file with [FILL] placeholder -->
							<div class="artifact-preview artifact-idea" aria-label="Artifact preview: flow/00-idea.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/00-idea.md</span>
									<span class="artifact-status-pill status-halt mono">HALT</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-kw">#</span> Problem statement</div>
									<div class="art-line art-line-warn"><span class="art-ln">2</span><span class="art-slot-fill">[FILL: describe user problem]</span></div>
									<div class="art-line"><span class="art-ln">3</span><span class="art-kw">#</span> Proposed solution</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-muted">&lt;empty&gt;</span></div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">exit: 1 · unresolved [FILL] token</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-fail" aria-labelledby="will-not-pass-title">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-fail" aria-hidden="true">
										<span class="fail-dot"></span>
									</span>
									<span class="proof-badge-label mono">FAIL · KILLED AT GATE</span>
									<h4 id="will-not-pass-title" class="proof-title">What will not pass</h4>
								</div>
								<p class="proof-intro">
									Empty, leftover <code translate="no">[FILL]</code>, or “tests pass” offered as done.
									<span class="kill-line">A weak idea is killed at the gate.</span>
								</p>
								<ul class="proofs">{willNotPass.map((item) => <li>{item}</li>)}</ul>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow next<br />
									<span class="receipt-err">refusing: flow/00-idea.md is empty (line 1)</span><br />
									<span class="receipt-halt">kill is a valid outcome.</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 02: Research -->
				<article class="gate-band" id="gate-02" aria-labelledby="gate-02-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">02</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">02</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-02-title">Research</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/01-research.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Cite real sources or stop here.</p>

							<!-- Artifact preview visual: Research primary sources citations -->
							<div class="artifact-preview artifact-research" aria-label="Artifact preview: flow/01-research.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/01-research.md</span>
									<span class="artifact-status-pill status-verified mono">3/3 CITED</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-kw">##</span> Primary sources</div>
									<div class="art-line art-line-cite"><span class="art-ln">2</span><span class="art-bullet">•</span> [RFC-9110] §4.2 Idempotent methods</div>
									<div class="art-line art-line-cite"><span class="art-ln">3</span><span class="art-bullet">•</span> github.com/owner/repo#412 (repro)</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-kw">##</span> Competitive diff &amp; failure modes</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">urls verified · ground truth locked</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">02</span>
									<span class="proof-badge-label mono">EVIDENCE · PRIMARY SOURCES</span>
									<h4 class="proof-title">Ground truth before architecture</h4>
								</div>
								<p class="proof-intro">
									Competitor diffs, verified documentation quotes, and real failure modes recorded to repo files.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 01-research<br />
									<span class="receipt-ok">✓ 3 primary sources cited (verified URLs)</span><br />
									<span class="receipt-ok">✓ competitive diff &amp; failure modes locked</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 03: Scope -->
				<article class="gate-band" id="gate-03" aria-labelledby="gate-03-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">03</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">03</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-03-title">Scope</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/02-scope.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Draw the boundary. Drop the rest.</p>

							<!-- Artifact preview visual: Scope in-scope vs non-goals perimeter -->
							<div class="artifact-preview artifact-scope" aria-label="Artifact preview: flow/02-scope.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/02-scope.md</span>
									<span class="artifact-status-pill status-frozen mono">FROZEN</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-tag-scope art-tag-in">IN-SCOPE</span> S-01 CLI harness gate loop</div>
									<div class="art-line"><span class="art-ln">2</span><span class="art-tag-scope art-tag-in">IN-SCOPE</span> S-02 Receipt schema validator</div>
									<div class="art-line art-line-cut"><span class="art-ln">3</span><span class="art-tag-scope art-tag-out">NON-GOAL</span> Telemetry / analytics tracking</div>
									<div class="art-line art-line-cut"><span class="art-ln">4</span><span class="art-tag-scope art-tag-out">NON-GOAL</span> Custom cloud daemon runtime</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">2 deliverable slices · perimeter frozen</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">03</span>
									<span class="proof-badge-label mono">PERIMETER · NON-GOALS</span>
									<h4 class="proof-title">Explicit non-goals frozen</h4>
								</div>
								<p class="proof-intro">
									Bounded delivery slices. Scope creep is caught before any code generation begins.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 02-scope<br />
									<span class="receipt-ok">✓ 3 deliverable slices locked</span><br />
									<span class="receipt-ok">✓ non-goals explicitly frozen (scope creep blocked)</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 04: PRD -->
				<article class="gate-band" id="gate-04" aria-labelledby="gate-04-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">04</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">04</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-04-title">PRD</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/03-prd.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Define the test before writing code.</p>

							<!-- Artifact preview visual: PRD observable invariant list -->
							<div class="artifact-preview artifact-prd" aria-label="Artifact preview: flow/03-prd.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">MD</span>
									<span class="artifact-path mono" translate="no">flow/03-prd.md</span>
									<span class="artifact-status-pill status-verified mono">CRITERIA</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-inv-id">INV-01:</span> exit 1 on empty spec file</div>
									<div class="art-line"><span class="art-ln">2</span><span class="art-inv-id">INV-02:</span> refusal line emitted to stderr</div>
									<div class="art-line"><span class="art-ln">3</span><span class="art-inv-id">INV-03:</span> receipt JSON conforms to schema</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-inv-id">INV-04:</span> degraded mode creates debt entry</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">4 observable invariants · 0 prose fluff</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">04</span>
									<span class="proof-badge-label mono">CONTRACT · ACCEPTANCE</span>
									<h4 class="proof-title">Observable criteria only</h4>
								</div>
								<p class="proof-intro">
									User stories with testable invariants. The agent cannot redefine success mid-flight.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 03-prd<br />
									<span class="receipt-ok">✓ observable acceptance criteria specified</span><br />
									<span class="receipt-ok">✓ error states &amp; degraded paths defined</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 05: ADR -->
				<article class="gate-band" id="gate-05" aria-labelledby="gate-05-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">05</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">05</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-05-title">ADR</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/04-adr.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Log the trade-off before you commit.</p>

							<!-- Artifact preview visual: ADR architecture decision record -->
							<div class="artifact-preview artifact-adr" aria-label="Artifact preview: flow/04-adr.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">ADR</span>
									<span class="artifact-path mono" translate="no">flow/04-adr.md</span>
									<span class="artifact-status-pill status-accepted mono">ACCEPTED</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line"><span class="art-ln">1</span><span class="art-field">Status:</span> <span class="art-val-ok">Accepted</span> (2026-10-11)</div>
									<div class="art-line"><span class="art-ln">2</span><span class="art-field">Context:</span> File state vs SQLite daemon</div>
									<div class="art-line"><span class="art-ln">3</span><span class="art-field">Decision:</span> Git-tracked Markdown files</div>
									<div class="art-line"><span class="art-ln">4</span><span class="art-field">Consequence:</span> Portable; zero background server</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">reversibility mapped · trade-off locked</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-verified">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-gate mono">05</span>
									<span class="proof-badge-label mono">DECISION · TRADE-OFFS</span>
									<h4 class="proof-title">Architecture Decision Records</h4>
								</div>
								<p class="proof-intro">
									Context, decision, and consequences recorded before implementation starts.
								</p>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> /flow check 04-adr<br />
									<span class="receipt-ok">✓ context, decision, consequences documented</span><br />
									<span class="receipt-ok">✓ reversibility &amp; negative test cases mapped</span>
								</div>
							</div>
						</div>
					</div>
				</article>

				<!-- Gate 06: Contract (Features After Install proof panel) -->
				<article class="gate-band" id="gate-06" aria-labelledby="gate-06-title">
					<div class="gate-rail-node" aria-hidden="true"></div>
					<span class="gate-watermark-num mono" aria-hidden="true">06</span>
					<div class="gate-band-inner">
						<div class="gate-meta">
							<div class="gate-meta-header">
								<span class="gate-big-num mono">06</span>
								<div class="gate-meta-text">
									<h3 class="gate-stage-name" id="gate-06-title">Contract</h3>
									<div class="gate-file-row">
										<code class="gate-file-chip mono" translate="no">flow/05-contract.md</code>
									</div>
								</div>
							</div>
							<p class="gate-tagline">Both sides agree or nothing advances.</p>

							<!-- Artifact preview visual: Signed verification contract -->
							<div class="artifact-preview artifact-contract" aria-label="Artifact preview: flow/05-contract.md">
								<div class="artifact-topbar">
									<span class="artifact-doc-icon mono">SIG</span>
									<span class="artifact-path mono" translate="no">flow/05-contract.md</span>
									<span class="artifact-status-pill status-pass mono">UNLOCKED</span>
								</div>
								<div class="artifact-body mono" translate="no">
									<div class="art-line art-line-pass"><span class="art-check">[✓]</span> human-signoff: approved by @dev</div>
									<div class="art-line art-line-pass"><span class="art-check">[✓]</span> harness-attest: sha256:7f3a..9e1b</div>
									<div class="art-line art-line-pass"><span class="art-check">[✓]</span> doctor-check: READY (skills verified)</div>
									<div class="art-line art-line-pass"><span class="art-check">[✓]</span> dual-agreement: UNLOCKED -&gt; advance</div>
								</div>
								<div class="artifact-footer mono">
									<span class="artifact-diag">signed contract · gate cleared for build</span>
								</div>
							</div>
						</div>
						<div class="gate-proof-area">
							<div class="proof-terminal proof-pass" aria-labelledby="after-install-title">
								<div class="proof-terminal-head">
									<span class="status-badge status-badge-pass" aria-hidden="true">
										<svg class="pass-mark" role="img" aria-label="PASS"><use href="#tick"></use></svg>
									</span>
									<span class="proof-badge-label mono">PASS · READY</span>
									<h4 id="after-install-title" class="proof-title">After install</h4>
								</div>
								<p class="proof-intro">
									The skill is on disk. <code translate="no">/flow</code> or
									<code translate="no">$flow</code> exists.
									<code translate="no">doctor</code> can print <code translate="no">READY</code>.
									<code translate="no">/flow next</code> on an empty idea file refuses with line
									numbers.
								</p>
								<ul class="proofs">{afterInstall.map((item) => <li>{item}</li>)}</ul>
								<div class="proof-code-receipt mono" translate="no">
									<span class="receipt-prompt">$</span> flow doctor<br />
									<span class="receipt-ok">doctor: READY (skills/flow/SKILL.md verified)</span><br />
									<span class="receipt-ok">The gate opens only when both agree.</span>
								</div>
							</div>
						</div>
					</div>
				</article>
			</div>

			<p class="band-foot">
				Then <code translate="no">/flow card</code>. Done means proof in the world: a deployed
				URL, a CLI that installs and runs, a public API, or a real skill run.
			</p>
		</section>

		<!-- CLOSING SECTION -->
		<section class="band stand" aria-labelledby="stand-title">
			<div class="stand-copy">
				<h2 class="stand-title" id="stand-title">Not an AI coding agent. A harness around one.</h2>
				<p>
					flow does not write your code. The agent still writes; the harness decides whether
					that work may advance.
				</p>
			</div>
			<div class="stand-actions">
